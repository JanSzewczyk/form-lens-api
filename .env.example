# Copy to .env. Every key is optional; the values below are the defaults unless noted.

APP_NAME=formlens
# local | test | production
ENVIRONMENT=local

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# auto (console when ENVIRONMENT=local, json otherwise) | json | console
LOG_FORMAT=auto

# Serve /docs, /redoc and /openapi.json. Keep it false on a public API; set true to read the docs
# while you develop.
DOCS_ENABLED=false
# JSON list. Empty (the default) turns CORS off. Never use "*" with credentials.
CORS_ORIGINS=[]
# CORS_ORIGINS=["https://app.example.com"]

HOST=127.0.0.1
PORT=8000
RELOAD=false
# Seconds open requests get to finish after SIGTERM. Keep it below the orchestrator's grace period
# (Kubernetes: 30 s by default). Behind a proxy, also set uvicorn's FORWARDED_ALLOW_IPS.
GRACEFUL_SHUTDOWN_SECONDS=20

DEFAULT_PAGE_SIZE=20

# Folder with the downloaded document models. `make download-models` and `make test-models` read
# MODELS_PATH and VLM_BACKEND from here too (an exported variable wins). A relative path is read
# from the working directory. An empty value is refused: leave the line out to get the default.
MODELS_PATH=./models
# mlx (the backend this project uses on Apple Silicon, macOS 14+) | transformers
VLM_BACKEND=mlx
# Largest accepted upload, in megabytes.
MAX_UPLOAD_MB=25
# Largest accepted JSON body of the template routes, in kilobytes (413 body-too-large past it). Keep it above
# the largest valid template: about 1.55 MB with every non-ASCII character escaped (see the README).
MAX_JSON_BODY_KB=2048
# Documents converted at the same time. The model is heavy; raise it only with memory to spare.
MAX_CONCURRENCY=1
# Seconds one document may take to parse. A slower one fails the request with 500 parse-failed.
PARSE_TIMEOUT_SECONDS=300

# SQLAlchemy URL of the database; only SQLite is supported. A relative file is read from the working
# directory. Create or update the tables with `make migrate` before the first start.
DB_URL=sqlite:///./formlens.db

# OpenAI-compatible endpoint of the local language model (Ollama). Documents are sent there, so only a
# loopback or private address (standard form), a name without a dot (trusted to resolve locally) or
# host.docker.internal is accepted.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:8b
# Seconds one call to the model may take. Must be below JOB_TIMEOUT_SECONDS.
LLM_TIMEOUT_SECONDS=120
# Longest document text sent to the model, in characters. A longer document fails the extraction.
LLM_MAX_INPUT_CHARS=20000

# Hours a finished extraction stays readable before it is deleted.
RESULT_TTL_HOURS=24
# Seconds one extraction job may run. Must be above PARSE_TIMEOUT_SECONDS.
JOB_TIMEOUT_SECONDS=600
# Times a job is started before it fails. 2 lets a restart run an interrupted job once more.
JOB_MAX_ATTEMPTS=2
# Seconds the idle worker waits before it looks for a job again.
JOB_POLL_INTERVAL_SECONDS=2.0
# Extractions that may wait at once. One more is refused with 503 queue-full.
QUEUE_MAX_PENDING=100
