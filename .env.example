# Copy to .env. Every key is optional; the values below are the defaults unless noted.

APP_NAME=fastapi-szumplate
# local | test | production
ENVIRONMENT=local

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# auto (console when ENVIRONMENT=local, json otherwise) | json | console
LOG_FORMAT=auto

# Serve /docs, /redoc and /openapi.json. Keep it false on a public API; set true to read the docs
# while you develop.
DOCS_ENABLED=false
# JSON list. Empty (the default) turns CORS off. Never use "*" with credentials.
CORS_ORIGINS=[]
# CORS_ORIGINS=["https://app.example.com"]

HOST=127.0.0.1
PORT=8000
RELOAD=false
# Seconds open requests get to finish after SIGTERM. Keep it below the orchestrator's grace period
# (Kubernetes: 30 s by default). Behind a proxy, also set uvicorn's FORWARDED_ALLOW_IPS.
GRACEFUL_SHUTDOWN_SECONDS=20

DEFAULT_PAGE_SIZE=20
# Example domain (src/fastapi_szumplate/library); remove with the example.
LOANS_MAX_ACTIVE_PER_MEMBER=3
LOAN_DAYS=14
