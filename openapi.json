{
  "components": {
    "schemas": {
      "Body_create_extraction": {
        "properties": {
          "file": {
            "contentMediaType": "application/octet-stream",
            "description": "The document: a PDF, PNG, JPEG or TIFF file. An empty file is refused with 400.",
            "minLength": 1,
            "title": "File",
            "type": "string"
          },
          "template_id": {
            "description": "Identifier of the template to read the document against.",
            "format": "uuid",
            "title": "Template Id",
            "type": "string"
          }
        },
        "required": [
          "file",
          "template_id"
        ],
        "title": "Body_create_extraction",
        "type": "object"
      },
      "Body_parse_document": {
        "properties": {
          "file": {
            "contentMediaType": "application/octet-stream",
            "description": "The document: a PDF, PNG, JPEG or TIFF file. An empty file is refused with 400.",
            "minLength": 1,
            "title": "File",
            "type": "string"
          }
        },
        "required": [
          "file"
        ],
        "title": "Body_parse_document",
        "type": "object"
      },
      "ExtractionErrorResponse": {
        "description": "Why an extraction failed.",
        "properties": {
          "message": {
            "description": "Fixed text for people. It never holds text of the document.",
            "examples": [
              "The extraction took longer than the time allowed."
            ],
            "title": "Message",
            "type": "string"
          },
          "reason": {
            "$ref": "#/components/schemas/FailureReason",
            "description": "Machine-readable cause; branch on this.",
            "examples": [
              "timed_out"
            ]
          }
        },
        "required": [
          "reason",
          "message"
        ],
        "title": "ExtractionErrorResponse",
        "type": "object"
      },
      "ExtractionResponse": {
        "description": "An extraction: where it is, and its result once it has one.",
        "properties": {
          "attempts": {
            "description": "How many times the worker took the job.",
            "examples": [
              1
            ],
            "minimum": 0.0,
            "title": "Attempts",
            "type": "integer"
          },
          "created_at": {
            "description": "When the document was submitted (UTC).",
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ExtractionErrorResponse"
              },
              {
                "type": "null"
              }
            ],
            "description": "Present when `status` is `failed`."
          },
          "finished_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "When the extraction ended (UTC). The result is kept for a limited time after this.",
            "title": "Finished At"
          },
          "id": {
            "description": "Identifier of the extraction.",
            "examples": [
              "0192f5e0-5a3b-7c11-9d2e-3f6a1b2c4d5e"
            ],
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "missing_required": {
            "description": "The required fields whose value is `null`. A completed result may have some; it is still delivered. Empty until the extraction completes.",
            "examples": [
              []
            ],
            "items": {
              "type": "string"
            },
            "title": "Missing Required",
            "type": "array"
          },
          "result": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "One key per field of the template, `null` where the document does not show a value. Present when `status` is `completed`.",
            "examples": [
              {
                "invoice_number": "FV/12/2026"
              }
            ],
            "title": "Result"
          },
          "started_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "When the worker took the job (UTC); `null` while it waits.",
            "title": "Started At"
          },
          "status": {
            "$ref": "#/components/schemas/ExtractionStatus",
            "description": "`pending` waits for the worker, `running` is being read, `completed` has a `result`, `failed` has an `error`.",
            "examples": [
              "pending"
            ]
          },
          "template_id": {
            "description": "The template the document is read against.",
            "examples": [
              "0192f5e0-5a3b-7c11-9d2e-3f6a1b2c4d00"
            ],
            "format": "uuid",
            "title": "Template Id",
            "type": "string"
          },
          "template_version": {
            "description": "The version of the template that was copied when the document was submitted; a later edit does not change this extraction.",
            "examples": [
              1
            ],
            "title": "Template Version",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "status",
          "template_id",
          "template_version",
          "missing_required",
          "attempts",
          "created_at"
        ],
        "title": "ExtractionResponse",
        "type": "object"
      },
      "ExtractionStatus": {
        "description": "Where an extraction is in its life.",
        "enum": [
          "pending",
          "running",
          "completed",
          "failed"
        ],
        "title": "ExtractionStatus",
        "type": "string"
      },
      "FailureReason": {
        "description": "Why an extraction failed.",
        "enum": [
          "invalid_file",
          "parse_failed",
          "llm_unavailable",
          "invalid_output",
          "timed_out",
          "interrupted",
          "document_too_long"
        ],
        "title": "FailureReason",
        "type": "string"
      },
      "FieldSpec": {
        "additionalProperties": false,
        "description": "One field of a form, as a client sends it and as it is returned.",
        "examples": [
          {
            "description": "Top right",
            "name": "invoice_number",
            "required": true,
            "type": "text"
          }
        ],
        "properties": {
          "allowed_values": {
            "anyOf": [
              {
                "items": {
                  "maxLength": 100,
                  "minLength": 1,
                  "type": "string"
                },
                "maxItems": 50,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "The values a `choice` field may take; required for `choice`, refused for other types.",
            "title": "Allowed Values"
          },
          "description": {
            "default": "",
            "description": "How the field appears on the form (its label, where it sits). It helps the extraction.",
            "examples": [
              "Invoice number, top right"
            ],
            "maxLength": 300,
            "title": "Description",
            "type": "string"
          },
          "maximum": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Largest value of a `number` or `integer` field.",
            "title": "Maximum"
          },
          "minimum": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Smallest value of a `number` or `integer` field.",
            "title": "Minimum"
          },
          "name": {
            "description": "The key of the field in the extraction result: lower case letters, digits and `_`, starting with a letter. Unique within the template.",
            "examples": [
              "invoice_number"
            ],
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_]*$",
            "title": "Name",
            "type": "string"
          },
          "pattern": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Regular expression a `text` value must match anywhere in it unless it is anchored (at most 200 characters). A linear-time subset: no lookahead, lookbehind or backreference.",
            "title": "Pattern"
          },
          "required": {
            "default": false,
            "description": "Whether a completed form must have a value. A result with a missing required field is still delivered and lists the field under `missing_required`.",
            "title": "Required",
            "type": "boolean"
          },
          "type": {
            "$ref": "#/components/schemas/FieldType",
            "description": "What the field holds.",
            "examples": [
              "text"
            ]
          }
        },
        "required": [
          "name",
          "type"
        ],
        "title": "FieldSpec",
        "type": "object"
      },
      "FieldType": {
        "description": "What a field holds.",
        "enum": [
          "text",
          "number",
          "integer",
          "boolean",
          "date",
          "choice"
        ],
        "title": "FieldType",
        "type": "string"
      },
      "HealthResponse": {
        "description": "Liveness probe payload.",
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "description": "Always `ok` while the process can answer.",
            "examples": [
              "ok"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "title": "HealthResponse",
        "type": "object"
      },
      "OutputFormat": {
        "description": "How the extracted text is returned.",
        "enum": [
          "markdown",
          "text"
        ],
        "title": "OutputFormat",
        "type": "string"
      },
      "ParseResponse": {
        "description": "The text extracted from one document.",
        "properties": {
          "elapsed_ms": {
            "description": "Time the model took, in milliseconds.",
            "examples": [
              8400
            ],
            "minimum": 0.0,
            "title": "Elapsed Ms",
            "type": "integer"
          },
          "model": {
            "description": "The model that read the document.",
            "examples": [
              "ibm-granite/granite-docling-258M-mlx"
            ],
            "title": "Model",
            "type": "string"
          },
          "page_count": {
            "description": "Number of pages the model read.",
            "examples": [
              1
            ],
            "minimum": 0.0,
            "title": "Page Count",
            "type": "integer"
          },
          "text": {
            "description": "The text of the document, as Markdown or as plain text, depending on `format`.",
            "examples": [
              "# Invoice 2024-001\n\nTotal: 120.00 EUR"
            ],
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text",
          "page_count",
          "elapsed_ms",
          "model"
        ],
        "title": "ParseResponse",
        "type": "object"
      },
      "ProblemDetail": {
        "description": "The one error shape every endpoint returns (RFC 9457).",
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Explanation of this occurrence. Do not parse it.",
            "examples": [
              "The resource does not exist."
            ],
            "title": "Detail"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ValidationIssue"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Rejected inputs; present on validation errors only.",
            "title": "Errors"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Value of the X-Request-ID response header, to quote when asking for support.",
            "examples": [
              "0192f5e0-5a3b-7c11-9d2e-3f6a1b2c4d5e"
            ],
            "title": "Request Id"
          },
          "status": {
            "description": "HTTP status code.",
            "examples": [
              404
            ],
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "description": "Short, stable summary of the kind.",
            "examples": [
              "Not Found"
            ],
            "title": "Title",
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "URI that identifies the kind of problem; clients branch on it.",
            "examples": [
              "urn:problem:formlens:validation-error"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "title",
          "status"
        ],
        "title": "ProblemDetail",
        "type": "object"
      },
      "ReadinessResponse": {
        "description": "Readiness probe payload.",
        "properties": {
          "checks": {
            "additionalProperties": {
              "const": "ok",
              "type": "string"
            },
            "description": "Name of each registered check with its result.",
            "examples": [
              {
                "storage": "ok"
              }
            ],
            "title": "Checks",
            "type": "object"
          },
          "status": {
            "const": "ready",
            "default": "ready",
            "description": "Every readiness check passed.",
            "examples": [
              "ready"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "checks"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "TemplateCreate": {
        "additionalProperties": false,
        "description": "The body of `POST /v1/templates`.",
        "properties": {
          "description": {
            "default": "",
            "description": "What the form is.",
            "examples": [
              "A supplier invoice with a total and a due date."
            ],
            "maxLength": 300,
            "title": "Description",
            "type": "string"
          },
          "fields": {
            "description": "The fields to extract, 1 to 50, with unique names.",
            "items": {
              "$ref": "#/components/schemas/FieldSpec"
            },
            "maxItems": 50,
            "minItems": 1,
            "title": "Fields",
            "type": "array"
          },
          "name": {
            "description": "Name of the form, for people.",
            "examples": [
              "Invoice"
            ],
            "maxLength": 100,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "fields"
        ],
        "title": "TemplateCreate",
        "type": "object"
      },
      "TemplatePage": {
        "description": "One page of templates.",
        "properties": {
          "items": {
            "description": "The items on this page.",
            "items": {
              "$ref": "#/components/schemas/TemplateResponse"
            },
            "title": "Items",
            "type": "array"
          },
          "limit": {
            "description": "Page size that was applied.",
            "examples": [
              20
            ],
            "minimum": 1.0,
            "title": "Limit",
            "type": "integer"
          },
          "offset": {
            "description": "Number of items skipped.",
            "examples": [
              0
            ],
            "minimum": 0.0,
            "title": "Offset",
            "type": "integer"
          },
          "total": {
            "description": "Number of items across all pages.",
            "examples": [
              1
            ],
            "minimum": 0.0,
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "title": "TemplatePage",
        "type": "object"
      },
      "TemplateReplace": {
        "additionalProperties": false,
        "description": "The body of `PUT /v1/templates/{template_id}`; it replaces everything and raises the version.",
        "properties": {
          "description": {
            "default": "",
            "description": "What the form is.",
            "examples": [
              "A supplier invoice with a total and a due date."
            ],
            "maxLength": 300,
            "title": "Description",
            "type": "string"
          },
          "fields": {
            "description": "The fields to extract, 1 to 50, with unique names.",
            "items": {
              "$ref": "#/components/schemas/FieldSpec"
            },
            "maxItems": 50,
            "minItems": 1,
            "title": "Fields",
            "type": "array"
          },
          "name": {
            "description": "Name of the form, for people.",
            "examples": [
              "Invoice"
            ],
            "maxLength": 100,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "fields"
        ],
        "title": "TemplateReplace",
        "type": "object"
      },
      "TemplateResponse": {
        "description": "A stored template.",
        "properties": {
          "created_at": {
            "description": "When the template was created (UTC).",
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "description": {
            "description": "What the form is.",
            "examples": [
              "A supplier invoice."
            ],
            "title": "Description",
            "type": "string"
          },
          "fields": {
            "description": "The fields to extract.",
            "items": {
              "$ref": "#/components/schemas/FieldSpec"
            },
            "title": "Fields",
            "type": "array"
          },
          "id": {
            "description": "Identifier of the template.",
            "examples": [
              "0192f5e0-5a3b-7c11-9d2e-3f6a1b2c4d5e"
            ],
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "json_schema": {
            "additionalProperties": true,
            "description": "The JSON Schema every extraction with this template must satisfy: one required key per field, each of which may be `null`.",
            "examples": [
              {
                "properties": {
                  "invoice_number": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "type": "object"
              }
            ],
            "title": "Json Schema",
            "type": "object"
          },
          "name": {
            "description": "Name of the form.",
            "examples": [
              "Invoice"
            ],
            "title": "Name",
            "type": "string"
          },
          "updated_at": {
            "description": "When the template was last replaced (UTC).",
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "version": {
            "description": "Starts at 1 and grows by one with every replacement.",
            "examples": [
              1
            ],
            "minimum": 1.0,
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "version",
          "fields",
          "json_schema",
          "created_at",
          "updated_at"
        ],
        "title": "TemplateResponse",
        "type": "object"
      },
      "ValidationIssue": {
        "description": "One rejected input value, without the value itself.",
        "properties": {
          "loc": {
            "description": "Where the problem is: `body`, `query`, `path` or `header`, then the field.",
            "examples": [
              [
                "query",
                "limit"
              ]
            ],
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Loc",
            "type": "array"
          },
          "msg": {
            "description": "What is wrong.",
            "examples": [
              "Input should be less than or equal to 100"
            ],
            "title": "Msg",
            "type": "string"
          },
          "type": {
            "description": "Pydantic error code.",
            "examples": [
              "less_than_equal"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationIssue",
        "type": "object"
      }
    }
  },
  "info": {
    "contact": {
      "name": "Szum-Tech",
      "url": "https://github.com/JanSzewczyk/form-lens-api"
    },
    "description": "FormLens API: extracts structured data from forms with a document model that runs locally.\n\nEvery error is returned as Problem Details (RFC 9457, `application/problem+json`). Branch on the\n`type` field, never on `detail`. Every response carries an `X-Request-ID` header; quote it when\nyou report a problem.\n",
    "license": {
      "name": "Proprietary (all rights reserved)"
    },
    "title": "formlens",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Report that the service is alive.\n\nThe probe answers without touching any dependency; use it for liveness.",
        "operationId": "get_health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Health",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "description": "Report whether the service can take traffic.\n\nRuns every registered readiness check. A failed check answers 503 and names the check, not\nthe error; the error is in the server log. Use it for readiness, not liveness.",
        "operationId": "get_readiness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Service not ready (`service-not-ready`)"
          }
        },
        "summary": "Get Readiness",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/documents/parse": {
      "post": {
        "description": "Parse a document and return its text.\n\nSend the file as multipart form data in the `file` field. The type is read from the file's own\nbytes, not from its name or Content-Type. A busy parser answers 503 with a `Retry-After` header.",
        "operationId": "parse_document",
        "parameters": [
          {
            "description": "`markdown` keeps headings and tables; `text` is plain text.",
            "in": "query",
            "name": "format",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/OutputFormat",
              "default": "markdown",
              "description": "`markdown` keeps headings and tables; `text` is plain text."
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_parse_document"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ParseResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "The file is empty or cannot be read (`invalid-file`), or the multipart body is malformed (`about:blank`)."
          },
          "413": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "File too large (`file-too-large`)"
          },
          "415": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Unsupported media type (`unsupported-media-type`)"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Request validation failed (`validation-error`): `file` is missing, is sent more than once or is a plain field; `format` is unknown."
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "The model failed or ran out of time (`parse-failed`)."
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Model unavailable (`model-unavailable`); Parser busy (`parser-busy`)",
            "headers": {
              "Retry-After": {
                "description": "Whole seconds to wait before trying again; set when the parser is busy.",
                "schema": {
                  "examples": [
                    5
                  ],
                  "type": "integer"
                }
              }
            }
          }
        },
        "summary": "Parse Document",
        "tags": [
          "documents"
        ]
      }
    },
    "/v1/extractions": {
      "post": {
        "description": "Queue a document to be read against a template.\n\nSend the file as multipart form data in the `file` field, with the `template_id` field. The answer comes\nat once, with status 202 and a `Location`; the document is read later. The file is refused at once when it\nis empty, too large or not a PDF, PNG, JPEG or TIFF. A full queue answers 503 with a `Retry-After` header.",
        "operationId": "create_extraction",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_create_extraction"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtractionResponse"
                }
              }
            },
            "description": "The document is queued. Poll the `Location` until `status` is `completed` or `failed`.",
            "headers": {
              "Location": {
                "description": "Where to read the extraction.",
                "schema": {
                  "examples": [
                    "/v1/extractions/0192f5e0-5a3b-7c11-9d2e-3f6a1b2c4d5e"
                  ],
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "The file is empty (`invalid-file`), or the multipart body is malformed (`about:blank`)."
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Template not found (`template-not-found`)"
          },
          "413": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "File too large (`file-too-large`)"
          },
          "415": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Unsupported media type (`unsupported-media-type`)"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Request validation failed (`validation-error`): `file` is missing, is sent more than once or is a plain field; `template_id` is missing, is sent more than once or is not a UUID."
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Queue full (`queue-full`)",
            "headers": {
              "Retry-After": {
                "description": "Whole seconds to wait before trying again; set when the queue is full.",
                "schema": {
                  "examples": [
                    30
                  ],
                  "type": "integer"
                }
              }
            }
          }
        },
        "summary": "Create Extraction",
        "tags": [
          "extractions"
        ]
      }
    },
    "/v1/extractions/{extraction_id}": {
      "get": {
        "description": "Return an extraction.\n\nWhile `status` is `pending` or `running`, ask again. A `completed` extraction has a `result` with one\nkey per field of the template (`null` where the document shows nothing) and the required fields that\ncame back `null` under `missing_required`. A `failed` one has an `error`. A result is kept for a limited\ntime after it ends, then the extraction is gone.",
        "operationId": "get_extraction",
        "parameters": [
          {
            "description": "Identifier of the extraction.",
            "in": "path",
            "name": "extraction_id",
            "required": true,
            "schema": {
              "description": "Identifier of the extraction.",
              "format": "uuid",
              "title": "Extraction Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtractionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "No extraction has this id, or its result expired (`extraction-not-found`)."
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Request validation failed (`validation-error`)"
          }
        },
        "summary": "Get Extraction",
        "tags": [
          "extractions"
        ]
      }
    },
    "/v1/templates": {
      "get": {
        "description": "List templates, oldest first, one page at a time.",
        "operationId": "list_templates",
        "parameters": [
          {
            "description": "Items per page, 1 to 100. Defaults to the configured page size (20 unless DEFAULT_PAGE_SIZE is set).",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 100,
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Items per page, 1 to 100. Defaults to the configured page size (20 unless DEFAULT_PAGE_SIZE is set).",
              "examples": [
                20
              ],
              "title": "Limit"
            }
          },
          {
            "description": "Items to skip from the start of the list.",
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "description": "Items to skip from the start of the list.",
              "examples": [
                0
              ],
              "maximum": 2147483647,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TemplatePage"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Request validation failed (`validation-error`)"
          }
        },
        "summary": "List Templates",
        "tags": [
          "templates"
        ]
      },
      "post": {
        "description": "Create a template.\n\nThe response carries the JSON Schema generated from the fields. Every field is a required key of the\nresult that may be `null`; the schema does not depend on which fields are `required` on the form.",
        "operationId": "create_template",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TemplateCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TemplateResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "The request body could not be read as text."
          },
          "413": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Request body too large (`body-too-large`)"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "The body is not valid, for instance too many fields or a name that is too long (`validation-error`), or the template breaks a rule the schema cannot state: duplicate field names, a choice without values, a range on a non-number, a pattern that does not compile (`invalid-template`)."
          }
        },
        "summary": "Create Template",
        "tags": [
          "templates"
        ]
      }
    },
