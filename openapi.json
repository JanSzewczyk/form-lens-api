{
  "components": {
    "schemas": {
      "HealthResponse": {
        "description": "Liveness probe payload.",
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "description": "Always `ok` while the process can answer.",
            "examples": [
              "ok"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "title": "HealthResponse",
        "type": "object"
      },
      "ProblemDetail": {
        "description": "The one error shape every endpoint returns (RFC 9457).",
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Explanation of this occurrence. Do not parse it.",
            "examples": [
              "The resource does not exist."
            ],
            "title": "Detail"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ValidationIssue"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Rejected inputs; present on validation errors only.",
            "title": "Errors"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Value of the X-Request-ID response header, to quote when asking for support.",
            "examples": [
              "0192f5e0-5a3b-7c11-9d2e-3f6a1b2c4d5e"
            ],
            "title": "Request Id"
          },
          "status": {
            "description": "HTTP status code.",
            "examples": [
              404
            ],
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "description": "Short, stable summary of the kind.",
            "examples": [
              "Not Found"
            ],
            "title": "Title",
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "URI that identifies the kind of problem; clients branch on it.",
            "examples": [
              "urn:problem:formlens:validation-error"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "title",
          "status"
        ],
        "title": "ProblemDetail",
        "type": "object"
      },
      "ReadinessResponse": {
        "description": "Readiness probe payload.",
        "properties": {
          "checks": {
            "additionalProperties": {
              "const": "ok",
              "type": "string"
            },
            "description": "Name of each registered check with its result.",
            "examples": [
              {
                "storage": "ok"
              }
            ],
            "title": "Checks",
            "type": "object"
          },
          "status": {
            "const": "ready",
            "default": "ready",
            "description": "Every readiness check passed.",
            "examples": [
              "ready"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "checks"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "ValidationIssue": {
        "description": "One rejected input value, without the value itself.",
        "properties": {
          "loc": {
            "description": "Where the problem is: `body`, `query`, `path` or `header`, then the field.",
            "examples": [
              [
                "query",
                "limit"
              ]
            ],
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Loc",
            "type": "array"
          },
          "msg": {
            "description": "What is wrong.",
            "examples": [
              "Input should be less than or equal to 100"
            ],
            "title": "Msg",
            "type": "string"
          },
          "type": {
            "description": "Pydantic error code.",
            "examples": [
              "less_than_equal"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationIssue",
        "type": "object"
      }
    }
  },
  "info": {
    "contact": {
      "name": "Szum-Tech",
      "url": "https://github.com/JanSzewczyk/form-lens-api"
    },
    "description": "FormLens API: extracts structured data from forms with a document model that runs locally.\n\nEvery error is returned as Problem Details (RFC 9457, `application/problem+json`). Branch on the\n`type` field, never on `detail`. Every response carries an `X-Request-ID` header; quote it when\nyou report a problem.\n",
    "license": {
      "name": "Proprietary (all rights reserved)"
    },
    "title": "formlens",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Report that the service is alive.\n\nThe probe answers without touching any dependency; use it for liveness.",
        "operationId": "get_health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Health",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "description": "Report whether the service can take traffic.\n\nRuns every registered readiness check. A failed check answers 503 and names the check, not\nthe error; the error is in the server log. Use it for readiness, not liveness.",
        "operationId": "get_readiness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Service not ready (`service-not-ready`)"
          }
        },
        "summary": "Get Readiness",
        "tags": [
          "health"
        ]
      }
    }
  },
  "servers": [
    {
      "description": "The host that serves this document",
      "url": "/"
    }
  ],
  "tags": [
    {
      "description": "Liveness and readiness probes. Not versioned.",
      "name": "health"
    }
  ]
}
