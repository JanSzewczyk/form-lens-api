{
  "components": {
    "schemas": {
      "BookCreate": {
        "additionalProperties": false,
        "description": "Body of `POST /v1/books`.",
        "properties": {
          "author": {
            "description": "Author of the book.",
            "examples": [
              "Robert C. Martin"
            ],
            "maxLength": 200,
            "minLength": 1,
            "pattern": "[^\\x09-\\x0d \\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
            "title": "Author",
            "type": "string"
          },
          "copies": {
            "description": "How many copies the library owns. Fixed once the book is created.",
            "examples": [
              3
            ],
            "maximum": 1000.0,
            "minimum": 1.0,
            "title": "Copies",
            "type": "integer"
          },
          "isbn": {
            "description": "ISBN-13, thirteen digits without hyphens. Unique across the catalogue.",
            "examples": [
              "9780132350884"
            ],
            "pattern": "^[0-9]{13}$",
            "title": "Isbn",
            "type": "string"
          },
          "title": {
            "description": "Title of the book.",
            "examples": [
              "Clean Code"
            ],
            "maxLength": 200,
            "minLength": 1,
            "pattern": "[^\\x09-\\x0d \\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "isbn",
          "title",
          "author",
          "copies"
        ],
        "title": "BookCreate",
        "type": "object"
      },
      "BookPage": {
        "description": "One page of books.",
        "properties": {
          "items": {
            "description": "The items on this page.",
            "items": {
              "$ref": "#/components/schemas/BookResponse"
            },
            "title": "Items",
            "type": "array"
          },
          "limit": {
            "description": "Page size that was applied.",
            "examples": [
              20
            ],
            "minimum": 1.0,
            "title": "Limit",
            "type": "integer"
          },
          "offset": {
            "description": "Number of items skipped.",
            "examples": [
              0
            ],
            "minimum": 0.0,
            "title": "Offset",
            "type": "integer"
          },
          "total": {
            "description": "Number of items across all pages.",
            "examples": [
              1
            ],
            "minimum": 0.0,
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "title": "BookPage",
        "type": "object"
      },
      "BookResponse": {
        "description": "A book as the API shows it.",
        "properties": {
          "author": {
            "description": "Author of the book.",
            "examples": [
              "Robert C. Martin"
            ],
            "maxLength": 200,
            "minLength": 1,
            "pattern": "[^\\x09-\\x0d \\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
            "title": "Author",
            "type": "string"
          },
          "copies": {
            "description": "How many copies the library owns.",
            "examples": [
              3
            ],
            "title": "Copies",
            "type": "integer"
          },
          "id": {
            "description": "Identifier assigned by the service.",
            "examples": [
              "0192f5e0-5a3b-7c11-9d2e-3f6a1b2c4d5e"
            ],
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "isbn": {
            "description": "ISBN-13, thirteen digits without hyphens. Unique across the catalogue.",
            "examples": [
              "9780132350884"
            ],
            "pattern": "^[0-9]{13}$",
            "title": "Isbn",
            "type": "string"
          },
          "title": {
            "description": "Title of the book.",
            "examples": [
              "Clean Code"
            ],
            "maxLength": 200,
            "minLength": 1,
            "pattern": "[^\\x09-\\x0d \\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "isbn",
          "title",
          "author",
          "copies"
        ],
        "title": "BookResponse",
        "type": "object"
      },
      "BookUpdate": {
        "additionalProperties": false,
        "description": "Body of `PUT /v1/books/{book_id}`. The ISBN and the capacity cannot change.",
        "properties": {
          "author": {
            "description": "Author of the book.",
            "examples": [
              "Robert C. Martin"
            ],
            "maxLength": 200,
            "minLength": 1,
            "pattern": "[^\\x09-\\x0d \\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
            "title": "Author",
            "type": "string"
          },
          "title": {
            "description": "Title of the book.",
            "examples": [
              "Clean Code"
            ],
            "maxLength": 200,
            "minLength": 1,
            "pattern": "[^\\x09-\\x0d \\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title",
          "author"
        ],
        "title": "BookUpdate",
        "type": "object"
      },
      "HealthResponse": {
        "description": "Liveness probe payload.",
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "description": "Always `ok` while the process can answer.",
            "examples": [
              "ok"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "title": "HealthResponse",
        "type": "object"
      },
      "LoanCreate": {
        "additionalProperties": false,
        "description": "Body of `POST /v1/loans`.",
        "properties": {
          "book_id": {
            "description": "Book to borrow.",
            "examples": [
              "0192f5e0-5a3b-7c11-9d2e-3f6a1b2c4d5e"
            ],
            "format": "uuid",
            "title": "Book Id",
            "type": "string"
          },
          "member_id": {
            "description": "Member identifier: letters, digits, dots, dashes or underscores, up to 64.",
            "examples": [
              "member-42"
            ],
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._-]+$",
            "title": "Member Id",
            "type": "string"
          }
        },
        "required": [
          "book_id",
          "member_id"
        ],
        "title": "LoanCreate",
        "type": "object"
      },
      "LoanPage": {
        "description": "One page of loans.",
        "properties": {
          "items": {
            "description": "The items on this page.",
            "items": {
              "$ref": "#/components/schemas/LoanResponse"
            },
            "title": "Items",
            "type": "array"
          },
          "limit": {
            "description": "Page size that was applied.",
            "examples": [
              20
            ],
            "minimum": 1.0,
            "title": "Limit",
            "type": "integer"
          },
          "offset": {
            "description": "Number of items skipped.",
            "examples": [
              0
            ],
            "minimum": 0.0,
            "title": "Offset",
            "type": "integer"
          },
          "total": {
            "description": "Number of items across all pages.",
            "examples": [
              1
            ],
            "minimum": 0.0,
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "title": "LoanPage",
        "type": "object"
      },
      "LoanResponse": {
        "description": "A loan as the API shows it.",
        "properties": {
          "book_id": {
            "description": "The borrowed book.",
            "examples": [
              "0192f5e0-5a3b-7c11-9d2e-3f6a1b2c4d5f"
            ],
            "format": "uuid",
            "title": "Book Id",
            "type": "string"
          },
          "borrowed_on": {
            "description": "Day the book was borrowed.",
            "examples": [
              "2026-01-06"
            ],
            "format": "date",
            "title": "Borrowed On",
            "type": "string"
          },
          "due_on": {
            "description": "Day the book is due back.",
            "examples": [
              "2026-01-20"
            ],
            "format": "date",
            "title": "Due On",
            "type": "string"
          },
          "id": {
            "description": "Identifier assigned by the service.",
            "examples": [
              "0192f5e0-5a3b-7c11-9d2e-3f6a1b2c4d5e"
            ],
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "member_id": {
            "description": "Member identifier: letters, digits, dots, dashes or underscores, up to 64.",
            "examples": [
              "member-42"
            ],
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._-]+$",
            "title": "Member Id",
            "type": "string"
          },
          "returned_on": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Day the book came back; `null` while it is still out.",
            "examples": [
              "2026-01-18"
            ],
            "title": "Returned On"
          }
        },
        "required": [
          "id",
          "book_id",
          "member_id",
          "borrowed_on",
          "due_on"
        ],
        "title": "LoanResponse",
        "type": "object"
      },
      "LoanReturn": {
        "additionalProperties": false,
        "description": "Optional body of `POST /v1/loans/{loan_id}/return`.",
        "properties": {
          "returned_on": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Day the book came back, `YYYY-MM-DD`. Defaults to today.",
            "examples": [
              "2026-01-20"
            ],
            "title": "Returned On"
          }
        },
        "title": "LoanReturn",
        "type": "object"
      },
      "ProblemDetail": {
        "description": "The one error shape every endpoint returns (RFC 9457).",
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Explanation of this occurrence. Do not parse it.",
            "examples": [
              "The resource does not exist."
            ],
            "title": "Detail"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ValidationIssue"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Rejected inputs; present on validation errors only.",
            "title": "Errors"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Value of the X-Request-ID response header, to quote when asking for support.",
            "examples": [
              "0192f5e0-5a3b-7c11-9d2e-3f6a1b2c4d5e"
            ],
            "title": "Request Id"
          },
          "status": {
            "description": "HTTP status code.",
            "examples": [
              404
            ],
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "description": "Short, stable summary of the kind.",
            "examples": [
              "Not Found"
            ],
            "title": "Title",
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "URI that identifies the kind of problem; clients branch on it.",
            "examples": [
              "urn:problem:fastapi-szumplate:validation-error"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "title",
          "status"
        ],
        "title": "ProblemDetail",
        "type": "object"
      },
      "ReadinessResponse": {
        "description": "Readiness probe payload.",
        "properties": {
          "checks": {
            "additionalProperties": {
              "const": "ok",
              "type": "string"
            },
            "description": "Name of each registered check with its result.",
            "examples": [
              {
                "storage": "ok"
              }
            ],
            "title": "Checks",
            "type": "object"
          },
          "status": {
            "const": "ready",
            "default": "ready",
            "description": "Every readiness check passed.",
            "examples": [
              "ready"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "checks"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "ValidationIssue": {
        "description": "One rejected input value, without the value itself.",
        "properties": {
          "loc": {
            "description": "Where the problem is: `body`, `query`, `path` or `header`, then the field.",
            "examples": [
              [
                "query",
                "limit"
              ]
            ],
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Loc",
            "type": "array"
          },
          "msg": {
            "description": "What is wrong.",
            "examples": [
              "Input should be less than or equal to 100"
            ],
            "title": "Msg",
            "type": "string"
          },
          "type": {
            "description": "Pydantic error code.",
            "examples": [
              "less_than_equal"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationIssue",
        "type": "object"
      }
    }
  },
  "info": {
    "contact": {
      "name": "Szum-Tech",
      "url": "https://github.com/JanSzewczyk/fastapi-szumplate"
    },
    "description": "Production-ready FastAPI service.\n\nEvery error is returned as Problem Details (RFC 9457, `application/problem+json`). Branch on the\n`type` field, never on `detail`. Every response carries an `X-Request-ID` header; quote it when\nyou report a problem.\n",
    "license": {
      "identifier": "MIT",
      "name": "MIT"
    },
    "title": "fastapi-szumplate",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Report that the service is alive.\n\nThe probe answers without touching any dependency; use it for liveness.",
        "operationId": "get_health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Health",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "description": "Report whether the service can take traffic.\n\nRuns every registered readiness check. A failed check answers 503 and names the check, not\nthe error; the error is in the server log. Use it for readiness, not liveness.",
        "operationId": "get_readiness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Service not ready (`service-not-ready`)"
          }
        },
        "summary": "Get Readiness",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/books": {
      "get": {
        "description": "List books, oldest first, one page at a time.",
        "operationId": "list_books",
        "parameters": [
          {
            "description": "Items per page, 1 to 100. Defaults to the configured page size (20 unless DEFAULT_PAGE_SIZE is set).",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 100,
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Items per page, 1 to 100. Defaults to the configured page size (20 unless DEFAULT_PAGE_SIZE is set).",
              "examples": [
                20
              ],
              "title": "Limit"
            }
          },
          {
            "description": "Items to skip from the start of the list.",
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "description": "Items to skip from the start of the list.",
              "examples": [
                0
              ],
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Request validation failed (`validation-error`)"
          }
        },
        "summary": "List Books",
        "tags": [
          "books"
        ]
      },
      "post": {
        "description": "Add a book to the catalogue.\n\nThe ISBN must not belong to another book. The capacity (`copies`) cannot be changed later.",
        "operationId": "create_book",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookResponse"
                }
              }
            },
            "description": "The book was created.",
            "headers": {
              "Location": {
                "description": "URL of the new book.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "links": {
              "GetBook": {
                "description": "Fetch the book that was just created.",
                "operationId": "get_book",
                "parameters": {
                  "book_id": "$response.body#/id"
                }
              },
              "LendBook": {
                "description": "Lend the new book to a member.",
                "operationId": "create_loan",
                "requestBody": {
                  "book_id": "$response.body#/id",
                  "member_id": "member-1"
                }
              },
              "UpdateBook": {
                "description": "Change the title or author of the new book.",
                "operationId": "update_book",
                "parameters": {
                  "book_id": "$response.body#/id"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "The request body could not be read as text."
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "ISBN already exists (`isbn-already-exists`)"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Request validation failed (`validation-error`)"
          }
        },
        "summary": "Create Book",
        "tags": [
          "books"
        ]
      }
    },
    "/v1/books/{book_id}": {
      "get": {
        "description": "Fetch one book by its id.",
        "operationId": "get_book",
        "parameters": [
          {
            "description": "Identifier of the book.",
            "in": "path",
            "name": "book_id",
            "required": true,
            "schema": {
              "description": "Identifier of the book.",
              "format": "uuid",
              "title": "Book Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Book not found (`book-not-found`)"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Request validation failed (`validation-error`)"
          }
        },
        "summary": "Get Book",
        "tags": [
          "books"
        ]
      },
      "put": {
        "description": "Replace the title and author of a book.\n\nThe ISBN and the number of copies are fixed; to change them, add a new book.",
        "operationId": "update_book",
        "parameters": [
          {
            "description": "Identifier of the book.",
            "in": "path",
            "name": "book_id",
            "required": true,
            "schema": {
              "description": "Identifier of the book.",
              "format": "uuid",
              "title": "Book Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "The request body could not be read as text."
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Book not found (`book-not-found`)"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Request validation failed (`validation-error`)"
          }
        },
        "summary": "Update Book",
        "tags": [
          "books"
        ]
      }
    },
    "/v1/loans": {
      "get": {
        "description": "List loans, oldest first, one page at a time, optionally for one member or only active.",
        "operationId": "list_loans",
        "parameters": [
          {
            "description": "Only loans of this member.",
            "in": "query",
            "name": "member_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 64,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only loans of this member.",
              "examples": [
